# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=LiOD
# Contact details on the back cover of every report
REPORT_CONTACT_EMAIL=tangent.analytics.ca@gmail.com
REPORT_CONTACT_WEBSITE=https://tangentanalytics.github.io/
SITE_URL=http://localhost:8000

# Database (PostGIS)
DATABASE_URL=postgis://app:app@db:5432/app
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# S3-compatible object storage (S3Mock locally, Cloudflare R2 in production)
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev
AWS_STORAGE_BUCKET_NAME=app-private
AWS_S3_ENDPOINT_URL=http://s3:9090
# Browser-facing address of the same bucket (dev only; leave empty in production).
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9090
AWS_S3_REGION_NAME=auto
AWS_QUERYSTRING_EXPIRE=300

# Email (Mailpit SMTP locally; Postmark or Resend via anymail in production)
EMAIL_URL=smtp://mailpit:1025
# Shown on sign-in pages when DEBUG is on: where dev emails can be read
DEV_MAILBOX_URL=http://localhost:8025
DEFAULT_FROM_EMAIL=no-reply@localhost
ADMIN_NOTIFICATION_EMAILS=ops@localhost
ANYMAIL_ESP=postmark
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=

# Payments. Demo mode fakes every payment method (development and sales demos).
PAYMENTS_DEMO_MODE=True
# Stripe test keys (sk_test_..., whsec_...) from dashboard.stripe.com; card payments use them when demo mode is off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps: Esri World Imagery (key required in production) and OSM Nominatim
ESRI_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Identify the app to Nominatim with a real contact address (usage policy).
NOMINATIM_USER_AGENT=Land Due Diligence (contact: ops@localhost)

# Google sign-in (django-allauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=

# Local OpenStreetMap extract (water, roads, services) and routing
OSM_EXTRACT_URL=https://download.geofabrik.de/africa/cameroon-latest.osm.pbf
OSM_DATA_DIR=/data/osm
WORLDPOP_DATA_DIR=/data/worldpop
# Google Open Buildings v3 (manage.py load_buildings) and JRC flood tiles (manage.py load_flood)
BUILDINGS_DATA_DIR=/data/buildings
FLOOD_DATA_DIR=/data/flood
VALHALLA_URL=http://valhalla:8002

# Claude (area-signals extraction, "suggest wording"). Empty = both features off.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
